<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.exceptionloader.reports</groupId>
        <artifactId>report-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>report-bukkit</artifactId>
    <name>Report Bukkit</name>
    <description>Paper plugin: commands, menus, forms and live notifications</description>

    <properties>
        <libs>dev.exceptionloader.reports.libs</libs>
    </properties>

    <dependencies>
        <dependency>
            <groupId>dev.exceptionloader.reports</groupId>
            <artifactId>report-common</artifactId>
        </dependency>
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
        </dependency>
        <dependency>
            <groupId>fr.minuskube.inv</groupId>
            <artifactId>smart-invs</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.spigotmc</groupId>
                    <artifactId>spigot-api</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jetbrains</groupId>
            <artifactId>annotations</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
        </dependency>
    </dependencies>

    <build>
        <finalName>ReportSystem-Bukkit-${project.version}</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>plugin.yml</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>plugin.yml</exclude>
                </excludes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <artifactSet>
                                <excludes>
                                    <!-- provided by Paper -->
                                    <exclude>com.google.code.gson:gson</exclude>
                                    <exclude>org.slf4j:*</exclude>
                                    <exclude>org.ow2.asm:*</exclude>
                                    <!-- annotations and unused transitive dependencies -->
                                    <exclude>org.jsoup:jsoup</exclude>
                                    <exclude>com.google.code.findbugs:jsr305</exclude>
                                    <exclude>com.google.errorprone:*</exclude>
                                    <exclude>com.google.j2objc:*</exclude>
                                    <exclude>com.github.spotbugs:*</exclude>
                                    <exclude>org.checkerframework:*</exclude>
                                </excludes>
                            </artifactSet>
                            <filters combine.children="append">
                                <filter>
                                    <artifact>fr.minuskube.inv:smart-invs</artifact>
                                    <excludes>
                                        <exclude>plugin.yml</exclude>
                                        <exclude>fr/minuskube/inv/SmartInvsPlugin.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <relocations>
                                <relocation>
                                    <pattern>com.google.inject</pattern>
                                    <shadedPattern>${libs}.guice</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>com.google.common</pattern>
                                    <shadedPattern>${libs}.guava</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>com.google.thirdparty</pattern>
                                    <shadedPattern>${libs}.guava.thirdparty</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>jakarta.inject</pattern>
                                    <shadedPattern>${libs}.inject</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>org.aopalliance</pattern>
                                    <shadedPattern>${libs}.aopalliance</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>dev.morphia</pattern>
                                    <shadedPattern>${libs}.morphia</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>com.mongodb</pattern>
                                    <shadedPattern>${libs}.mongodb</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>org.bson</pattern>
                                    <shadedPattern>${libs}.bson</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>redis.clients</pattern>
                                    <shadedPattern>${libs}.redis</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>org.apache.commons.pool2</pattern>
                                    <shadedPattern>${libs}.pool2</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>org.json</pattern>
                                    <shadedPattern>${libs}.json</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>fr.minuskube.inv</pattern>
                                    <shadedPattern>${libs}.smartinvs</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>net.bytebuddy</pattern>
                                    <shadedPattern>${libs}.bytebuddy</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>io.github.classgraph</pattern>
                                    <shadedPattern>${libs}.classgraph</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>nonapi.io.github.classgraph</pattern>
                                    <shadedPattern>${libs}.classgraph.nonapi</shadedPattern>
                                </relocation>
                            </relocations>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
