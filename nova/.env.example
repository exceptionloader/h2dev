# Copy to backend/.env for running the backend outside Docker.
NOVA_ENVIRONMENT=development
NOVA_DATABASE_URL=postgresql+asyncpg://nova:nova@localhost:5432/nova
NOVA_TEST_DATABASE_URL=postgresql+asyncpg://nova:nova@localhost:5432/nova_test
NOVA_ALLOWED_ORIGINS=http://localhost:5173
NOVA_FRONTEND_URL=http://localhost:5173
# Production only: requires HTTPS.
NOVA_SESSION_COOKIE_SECURE=false

# Uploads: local directory (default) or s3
NOVA_STORAGE_BACKEND=local
NOVA_STORAGE_LOCAL_PATH=./data/uploads

# Mail: leave NOVA_SMTP_HOST empty to only log mails (development)
NOVA_SMTP_HOST=
NOVA_SMTP_PORT=587
NOVA_SMTP_SECURITY=starttls

# Voice (LiveKit dev server: livekit-server --dev)
NOVA_LIVEKIT_URL=ws://localhost:7880
NOVA_LIVEKIT_API_KEY=devkey
NOVA_LIVEKIT_API_SECRET=secret

# First-party bot (run nova/bot with the same token)
NOVA_FIRST_PARTY_BOT_TOKEN=nb_dev_only_first_party_bot_token
