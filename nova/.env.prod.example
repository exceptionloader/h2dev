# Copy to .env.prod and fill in. Never commit .env.prod.
NOVA_DOMAIN=nova.example.com
LIVEKIT_DOMAIN=voice.nova.example.com
ACME_EMAIL=admin@example.com

# Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
NOVA_BOT_TOKEN=

# Mail (e.g. Brevo, Mailjet, Postmark – EU providers recommended for GDPR)
NOVA_SMTP_HOST=
NOVA_SMTP_PORT=587
NOVA_SMTP_USERNAME=
NOVA_SMTP_PASSWORD=
NOVA_MAIL_FROM=NOVA <no-reply@nova.example.com>

# Uploads: "local" (volume) or "s3" (Hetzner Object Storage, Cloudflare R2, MinIO, AWS …)
NOVA_STORAGE_BACKEND=local
NOVA_S3_BUCKET=
NOVA_S3_ENDPOINT_URL=
NOVA_S3_REGION=eu-central-1
NOVA_S3_ACCESS_KEY=
NOVA_S3_SECRET_KEY=
